# Copy to .env and adjust. .env is gitignored; this file lists every variable a
# developer is expected to set. Docker Compose reads the *_HOST_PORT values;
# the Python code run on the host reads the client-side ones.

# ── Host ports published by docker-compose.yml ─────────────
# Change one only when the default is taken on this machine.
KAFKA_HOST_PORT=9092
POSTGRES_HOST_PORT=5433
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
REDIS_HOST_PORT=6379
ES_HOST_PORT=9200
KIBANA_HOST_PORT=5601
SUPERSET_HOST_PORT=8088
SPARK_UI_HOST_PORT=8080
SPARK_RPC_HOST_PORT=7077
SPARK_WORKER_UI_HOST_PORT=8081

# ── Credentials (shared by the containers and host clients) ─
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=data_warehouse
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Host-side clients: tests, notebooks, scripts run outside Docker ──
# Each port must equal the matching *_HOST_PORT above.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
REDIS_HOST=localhost
REDIS_PORT=6379
ES_HOST=http://localhost:9200

# ── Data lake for host runs ─────────────────────────────────
# local writes under DATA_LAKE_LOCAL_ROOT; minio uses MINIO_ENDPOINT. The
# Compose services always run against MinIO, whatever is set here.
DATA_LAKE_PROFILE=local
# DATA_LAKE_LOCAL_ROOT=./data/lakehouse

# ── Legacy Kaggle demo (profile `legacy`) ───────────────────
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=8g

# ── Batch scheduler (profile `batch`) ───────────────────────
# MARKETPLACE_BATCH_INTERVAL_SECONDS=86400
# MARKETPLACE_BATCH_AS_OF_LAG_SECONDS=1800

# ── Operational projector (profile `ops`, service es-projector) ──
# How often the audit and DLQ rows are projected into the four
# marketplace-* operational indices, and how far back each pass re-reads.
# The overlap must exceed the interval, or a pass that fails leaves a gap
# nothing reads again.
# MARKETPLACE_OPS_PROJECT_INTERVAL_SECONDS=30
# MARKETPLACE_OPS_PROJECT_OVERLAP_SECONDS=900
