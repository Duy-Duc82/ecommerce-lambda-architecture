  {
   "type": "timeseries",
   "title": "Task kết thúc / giờ theo trạng thái",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (state) (increase(airflow_ti_finish{state!=\"\"}[1h]))",
     "legendFormat": "{{state}}",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60,
      "lineWidth": 1,
      "showPoints": "never",
      "stacking": {
       "mode": "normal"
      }
