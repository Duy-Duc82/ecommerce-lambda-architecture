  {
   "type": "table",
   "title": "Task kết thúc trong 24 giờ",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (dag_id, task_id, state) (airflow_task_24h_task_instances)",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge"
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "instance": true,
       "project": true
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true
   },
   "id": 5,
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 6
   }
