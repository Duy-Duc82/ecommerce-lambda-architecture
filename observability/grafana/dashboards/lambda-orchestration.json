  {
   "type": "stat",
   "title": "Lần thành công gần nhất",
   "description": "Chỉ marketplace_batch chạy hằng giờ; discovery hằng ngày, maintenance hằng tuần.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "time() - max by (dag_id) (airflow_dag_last_success_timestamp > 0)",
     "legendFormat": "{{dag_id}}",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 5400
       },
       {
        "color": "red",
        "value": 9000
       }
      ]
     },
     "mappings": [],
     "noValue": "–"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "textMode": "value_and_name",
    "graphMode": "none",
    "justifyMode": "auto"
   },
   "id": 2,
   "gridPos": {
    "h": 5,
    "w": 12,
    "x": 0,
    "y": 1
   }
  },
  {
   "type": "stat",
   "title": "DAG đang pause",
   "description": "",
