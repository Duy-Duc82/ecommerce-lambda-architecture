  {
   "type": "timeseries",
   "title": "Áp lực bộ nhớ (PSI): giây chờ / giây",
   "description": "> 0 kéo dài nghĩa là tiến trình phải chờ bộ nhớ: dấu hiệu thiếu RAM trước khi OOM.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate(node_pressure_memory_waiting_seconds_total[2m])",
     "legendFormat": "some",
     "instant": false,
     "range": true
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate(node_pressure_memory_stalled_seconds_total[2m])",
     "legendFormat": "full",
     "instant": false,
