  {
   "type": "timeseries",
   "title": "CPU",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m]))) * 100",
     "legendFormat": "CPU %",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 10,
      "lineWidth": 1,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 2,
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 1
   }
  },
  {
