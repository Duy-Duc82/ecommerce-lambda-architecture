  {
   "type": "timeseries",
   "title": "Đĩa đã dùng",
   "description": "/mnt/host/c là ổ C: của Windows, nơi file đĩa ảo của Docker Desktop phình ra.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (mountpoint) ((1 - node_filesystem_avail_bytes{mountpoint=~\"/|/mnt/docker-desktop-disk|/mnt/host/c\", fstype!~\"tmpfs|rootfs\"} / node_filesystem_size_bytes{mountpoint=~\"/|/mnt/docker-desktop-disk|/mnt/host/c\", fstype!~\"tmpfs|rootfs\"}) * 100)",
     "legendFormat": "{{mountpoint}}",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 10,
      "lineWidth": 1,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 5,
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 9
   }
