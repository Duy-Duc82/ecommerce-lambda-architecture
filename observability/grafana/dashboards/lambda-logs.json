{
 "uid": "lambda-logs",
 "title": "Lambda — log theo layer",
 "timezone": "Asia/Ho_Chi_Minh",
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "schemaVersion": 39,
 "tags": [
  "lambda",
  "logs"
 ],
 "links": [
  {
   "title": "Dashboards",
   "type": "dashboards",
   "tags": [
    "lambda"
   ],
   "asDropdown": false,
   "includeVars": false
  }
 ],
 "templating": {
  "list": [
   {
    "name": "layer",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "definition": "label_values(layer)",
    "query": {
     "label": "layer",
     "type": 1,
     "stream": "",
     "refId": "LokiVariableQueryEditor-VariableQuery"
    },
    "multi": true,
    "includeAll": true,
    "allValue": ".+",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2
   },
   {
    "name": "service",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "definition": "label_values(service)",
    "query": {
     "label": "service",
     "type": 1,
     "stream": "{layer=~\"$layer\"}",
     "refId": "LokiVariableQueryEditor-VariableQuery"
    },
    "multi": true,
    "includeAll": true,
    "allValue": ".+",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2
   },
   {
    "name": "run_id",
    "type": "textbox",
    "label": "run_id (regex, ví dụ mp-20261025T1400Z)",
    "query": ".*",
    "current": {
     "text": ".*",
     "value": ".*"
    }
   },
   {
    "name": "search",
    "type": "textbox",
    "label": "Tìm trong log (regex)",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    }
   }
  ]
 },
