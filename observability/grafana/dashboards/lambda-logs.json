{
 "uid": "lambda-logs",
 "title": "Lambda pipeline — log theo layer",
 "timezone": "Asia/Ho_Chi_Minh",
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "schemaVersion": 39,
 "tags": [
  "lambda",
  "logs"
 ],
 "templating": {
  "list": [
   {
    "name": "layer",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": {
     "label": "layer",
     "type": 1,
     "stream": "",
     "refId": "LokiVariableQueryEditor-VariableQuery"
    },
    "definition": "label_values(layer)",
    "multi": true,
    "includeAll": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2
   },
   {
    "name": "service",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": {
     "label": "service",
     "type": 1,
     "stream": "{project=\"mp-tikihtml\", layer=~\"$layer\"}",
     "refId": "LokiVariableQueryEditor-VariableQuery"
    },
    "definition": "label_values(service)",
    "multi": true,
    "includeAll": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2
   },
   {
    "name": "search",
    "type": "textbox",
    "label": "Tìm trong log (regex)",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    }
   }
  ]
 },
 "panels": [
  {
   "type": "timeseries",
   "title": "Số dòng log / phút theo layer",
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (layer) (count_over_time({project=\"mp-tikihtml\", layer=~\"$layer\"}[1m]))",
     "legendFormat": "{{layer}}",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "sum"
     ]
    }
   },
   "id": 1,
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   }
  },
  {
   "type": "timeseries",
   "title": "Lỗi / 5 phút theo layer (level=error: ERROR, FATAL, Traceback, XxxError:)",
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (layer) (count_over_time({project=\"mp-tikihtml\", layer=~\"$layer\", level=\"error\"} [5m]))",
     "legendFormat": "{{layer}}",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "sum"
     ]
    }
   },
   "id": 2,
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   }
  },
  {
   "type": "stat",
   "title": "Lỗi trong khoảng thời gian đang chọn",
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (layer) (count_over_time({project=\"mp-tikihtml\", layer=~\"$layer\", level=\"error\"} [$__range]))",
     "legendFormat": "{{layer}}",
     "instant": true,
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "textMode": "value_and_name"
   },
   "id": 3,
   "gridPos": {
    "h": 5,
    "w": 24,
    "x": 0,
    "y": 8
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   }
  },
