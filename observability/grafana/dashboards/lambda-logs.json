  {
   "type": "timeseries",
   "title": "Số dòng log / phút theo layer",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (layer) (count_over_time({layer=~\"$layer\"}[1m]))",
     "legendFormat": "{{layer}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60,
      "lineWidth": 1,
