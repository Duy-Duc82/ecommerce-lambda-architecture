// Phase 10 marketplace star schema (docs/DATA_MODEL.md section 4).
// Paste into https://dbdiagram.io/d to draw it.

Project marketplace_dw {
  database_type: 'PostgreSQL'
  Note: 'Kimball star for the marketplace price branch (Tiki, Lazada). Stored as Delta tables in the lake (gold/marketplace/dw/), never in PostgreSQL; the PostgreSQL types are for drawing only. Surrogate keys are deterministic xxhash64; -1 is the unknown member.'
}

TableGroup dimensions {
  dw.dim_date
  dw.dim_marketplace
  dw.dim_seller
  dw.dim_brand
  dw.dim_category
  dw.bridge_category_ancestry
  dw.dim_product_listing
  dw.dim_listing_flags
}

TableGroup facts {
  dw.fact_offer_observation
  dw.fact_price_snapshot_daily
  dw.fact_price_change
  dw.fact_counter_daily
  dw.fact_category_page_daily
  dw.fact_crawl_attempt
}

Table dw.dim_date {
  date_key int [pk, note: 'yyyymmdd; -1 unknown']
  full_date date [unique]
  day_of_week smallint
  day_name varchar
  week_of_year smallint [note: 'ISO week']
  month smallint
  month_name varchar
  quarter smallint
  year smallint
  is_weekend boolean
  is_double_day_sale boolean [note: '1/1, 2/2 ... 12/12']
  is_vn_holiday boolean
  Note: 'Conformed with the Kaggle behavior star: one builder for both.'
}

Table dw.dim_marketplace {
  marketplace_key bigint [pk]
  marketplace_code varchar [unique, not null, note: 'tiki | lazada']
  marketplace_id varchar
  marketplace_name varchar
  platform_type varchar [note: 'marketplace | retailer | classifieds | price_comparison']
  country char(2)
  default_currency char(3)
  first_crawled_at timestamptz
  Note: 'SCD1. A new marketplace is a new row.'
}

Table dw.dim_seller {
  seller_key bigint [pk]
  seller_id varchar [unique, not null, note: 'already marketplace-scoped (make_seller_id)']
  marketplace_key bigint [ref: > dw.dim_marketplace.marketplace_key]
  seller_name varchar
  seller_type varchar [note: 'as the source names it: OFFICIAL_STORE, NONE, LAZMALL ...']
  is_official_store boolean
  is_trusted_store boolean [null, note: 'NULL when the source has no such badge (Lazada)']
  first_seen_at timestamptz
  last_seen_at timestamptz
  observed_listing_count int
  Note: 'SCD1: descriptive columns from the latest sighting in <source>_listing_wide.'
}

Table dw.dim_brand {
  brand_key bigint [pk, note: 'xxhash64(marketplace_code, brand_id)']
  marketplace_key bigint [ref: > dw.dim_marketplace.marketplace_key]
  brand_id varchar [not null, note: 'the marketplace\'s own id']
  brand_name varchar
  first_seen_at timestamptz
  last_seen_at timestamptz
  observed_listing_count int
  indexes {
    (marketplace_key, brand_id) [unique]
  }
  Note: 'SCD1. A listing without a brand id points to -1.'
}

Table dw.dim_category {
  category_key bigint [pk, note: 'xxhash64(marketplace_code, category_id)']
  marketplace_key bigint [ref: > dw.dim_marketplace.marketplace_key]
  category_id varchar [not null, note: 'Tiki numeric id, Lazada URL slug']
  category_name varchar [null, note: 'NULL where no page named the node']
  category_slug varchar [null, note: 'Tiki categoryData.url_key or frontier target; Lazada = category_id']
  parent_key bigint [ref: > dw.dim_category.category_key]
  level smallint [note: 'root = 1']
  full_path varchar [note: '1/2/1789/1795']
  breadcrumb varchar [note: 'names of the named ancestors and the node, top first, joined by > ']
  category_l1_name varchar
  category_l2_name varchar
  category_l3_name varchar
  category_l4_name varchar
  is_leaf boolean
  indexes {
    (marketplace_key, category_id) [unique]
  }
  Note: 'Ragged hierarchy (4-8 levels): the one deliberate snowflake.'
}

Table dw.bridge_category_ancestry {
  ancestor_key bigint [ref: > dw.dim_category.category_key]
  descendant_key bigint [ref: > dw.dim_category.category_key]
  depth smallint [note: '0 = the node itself']
  indexes {
    (ancestor_key, descendant_key) [pk]
  }
  Note: 'Closure table: every listing under node X in one join.'
}

Table dw.dim_product_listing {
  listing_key bigint [pk, note: 'xxhash64(offer_id, valid_from)']
  offer_key bigint [not null, note: 'durable: xxhash64(offer_id)']
  offer_id varchar [not null]
  marketplace_key bigint [ref: > dw.dim_marketplace.marketplace_key]
  platform_listing_id varchar
  sku varchar [note: 'SCD1']
  master_product_sku varchar [null, note: 'SCD1; Tiki only']
  product_title text [note: 'SCD2']
  brand_key bigint [ref: > dw.dim_brand.brand_key, note: 'SCD2; -1 for 13.9% of Tiki products']
  category_key bigint [ref: > dw.dim_category.category_key, note: 'SCD2']
  seller_key bigint [ref: > dw.dim_seller.seller_key, note: 'SCD2']
  origin varchar [null, note: 'SCD1; Tiki only, as written']
  is_authentic boolean [null, note: 'SCD1; Tiki only']
  is_platform_verified boolean [null, note: 'SCD1; Tiki tiki_verified']
  source_url text [note: 'SCD1']
  valid_from timestamptz [not null]
  valid_to timestamptz [note: 'exclusive; 9999-12-31 for the current row']
  is_current boolean
  version int
  indexes {
    (offer_id, valid_from) [unique]
    offer_key
  }
}

Table dw.dim_listing_flags {
  listing_flags_key bigint [pk, note: 'xxhash64 of the nine flags']
  availability varchar [note: 'IN_STOCK | OUT_OF_STOCK | UNKNOWN']
  active_status varchar [note: 'ACTIVE | INACTIVE | UNKNOWN']
  has_discount boolean
  has_rating boolean
  has_free_shipping boolean [null]
  is_express_delivery boolean [null]
  is_next_day_delivery boolean [null]
  is_flash_deal boolean [null]
  is_gift_available boolean [null]
  Note: 'Junk dimension, replaces dim_offer_status: 3 x 3 x 2 x 2 x 3^5 = 8748 rows generated up front, plus the unknown row. NULL = the source does not publish the flag.'
}

Table dw.fact_offer_observation {
  observation_id varchar [pk, note: 'degenerate dimension']
  date_key int [ref: > dw.dim_date.date_key]
  marketplace_key bigint [ref: > dw.dim_marketplace.marketplace_key]
  listing_key bigint [ref: > dw.dim_product_listing.listing_key, note: 'version valid at observed_at']
  offer_key bigint [note: 'durable']
  seller_key bigint [ref: > dw.dim_seller.seller_key]
  brand_key bigint [ref: > dw.dim_brand.brand_key]
  category_key bigint [ref: > dw.dim_category.category_key, note: 'the listing\'s own category; the page\'s where the source has none']
  page_category_key bigint [ref: > dw.dim_category.category_key, note: 'the category page it was found on']
  listing_flags_key bigint [ref: > dw.dim_listing_flags.listing_flags_key]
  observed_at timestamptz
  fetched_at timestamptz
  currency char(3)
  current_price numeric(38,6)
  list_price numeric(38,6)
  shipping_price numeric(38,6)
  discount_amount numeric(38,6)
  discount_percent numeric(9,4)
  rating_value numeric(38,6)
  rating_scale numeric(38,6)
  rating_count bigint
  review_count bigint
  sold_count bigint
  ranking_position bigint [note: 'organic rank; NULL for a sponsored row']
  search_rank bigint [note: 'rank as displayed, sponsored rows included']
  request_page int
  is_advertisement boolean
  crawl_run_id varchar [note: 'lineage']
  raw_uri text [note: 'lineage to Bronze body.bin']
  raw_sha256 char(64) [note: 'lineage']
  adapter_version varchar [note: 'lineage; counter semantics']
  Note: 'Transaction fact. Grain: one sighting of one offer by the crawler at one instant.'
}

Table dw.fact_price_snapshot_daily {
  date_key int [ref: > dw.dim_date.date_key]
  offer_key bigint [note: 'durable']
  currency char(3)
  listing_key bigint [ref: > dw.dim_product_listing.listing_key, note: 'version at the day\'s last sighting']
  marketplace_key bigint [ref: > dw.dim_marketplace.marketplace_key]
  seller_key bigint [ref: > dw.dim_seller.seller_key]
  brand_key bigint [ref: > dw.dim_brand.brand_key]
  category_key bigint [ref: > dw.dim_category.category_key]
  listing_flags_key bigint [ref: > dw.dim_listing_flags.listing_flags_key, note: 'end of day']
  first_observed_at timestamptz
  last_observed_at timestamptz
  last_observation_id varchar
  open_price numeric(38,6)
  close_price numeric(38,6)
  min_price numeric(38,6)
  max_price numeric(38,6)
  avg_price numeric(38,6)
  first_list_price numeric(38,6)
  last_list_price numeric(38,6)
  observation_count int
  distinct_price_count int
  in_stock_ratio numeric(5,4)
  indexes {
    (date_key, offer_key, currency) [pk]
  }
  Note: 'Periodic snapshot (sparse). Grain: one offer x UTC day x currency with at least one sighting.'
}

Table dw.fact_price_change {
  observation_id varchar [pk, note: 'the sighting that showed the new price']
  previous_observation_id varchar
  date_key int [ref: > dw.dim_date.date_key]
  marketplace_key bigint [ref: > dw.dim_marketplace.marketplace_key]
  listing_key bigint [ref: > dw.dim_product_listing.listing_key]
  offer_key bigint [note: 'durable']
  seller_key bigint [ref: > dw.dim_seller.seller_key]
  brand_key bigint [ref: > dw.dim_brand.brand_key]
  category_key bigint [ref: > dw.dim_category.category_key]
  changed_at timestamptz [note: 'when the crawler saw it']
  previous_observed_at timestamptz
  currency char(3)
  previous_currency char(3)
  old_price numeric(38,6)
  new_price numeric(38,6)
  price_delta numeric(38,6)
  pct_change numeric(18,6) [note: 'NULL when the currency changed or old_price = 0']
  minutes_since_previous numeric(12,2)
  direction varchar [note: 'UP | DOWN']
  is_large_drop boolean [note: 'the speed layer rule']
  change_rule_version varchar
  Note: 'Transaction fact (derived). Grain: one sighting whose price differs from the offer\'s previous sighting.'
}

Table dw.fact_counter_daily {
  date_key int [ref: > dw.dim_date.date_key]
  offer_key bigint [note: 'durable']
  counter_name varchar [note: 'rating_count | review_count | sold_count']
  listing_key bigint [ref: > dw.dim_product_listing.listing_key, note: 'version at the day\'s last sighting']
  marketplace_key bigint [ref: > dw.dim_marketplace.marketplace_key]
  first_value bigint
  last_value bigint
  raw_delta_sum bigint
  valid_delta_sum bigint
  valid_transition_count int
  invalid_transition_count int
  elapsed_seconds_valid bigint
  velocity_proxy_per_hour double
  counter_reset_or_invalid boolean
  invalid_reasons_json text
  counter_rule_version varchar
  indexes {
    (date_key, offer_key, counter_name) [pk]
  }
  Note: 'Periodic snapshot (sparse). Public counters; a proxy, not sales.'
}

Table dw.fact_category_page_daily {
  date_key int [ref: > dw.dim_date.date_key]
  category_key bigint [ref: > dw.dim_category.category_key, note: 'the crawled page\'s category']
  currency char(3)
  marketplace_key bigint [ref: > dw.dim_marketplace.marketplace_key]
  crawled_page_count int
  listed_product_count bigint [note: 'the site\'s own total for the category, last of the day']
  observation_count int
  observed_offer_count int
  advertisement_count int
  seller_count int
  brand_count int
  min_price numeric(38,6)
  p25_price numeric(38,6)
  median_price numeric(38,6)
  p75_price numeric(38,6)
  max_price numeric(38,6)
  avg_price numeric(38,6)
  discounted_offer_count int
  discounted_offer_ratio numeric(5,4)
  median_discount_percent numeric(9,4)
  in_stock_ratio numeric(5,4)
  indexes {
    (date_key, category_key, currency) [pk]
  }
  Note: 'Periodic snapshot (sparse). Grain: one crawled category page x UTC day x currency. Prices over offers (each offer\'s last price of the day), not sightings.'
}

Table dw.fact_crawl_attempt {
  attempt_id bigint [pk, note: 'audit.crawl_request_attempt sequence']
  date_key int [ref: > dw.dim_date.date_key]
  marketplace_key bigint [ref: > dw.dim_marketplace.marketplace_key]
  category_key bigint [ref: > dw.dim_category.category_key, note: '-1 if not a category page']
  crawl_run_id varchar
  task_id varchar
  resource_type varchar
  attempt_number int
  started_at timestamptz
  completed_at timestamptz
  status varchar
  http_status int
  error_kind varchar
  latency_ms bigint
  raw_bytes bigint
  parsed_count bigint
  rejected_count bigint
  raw_uri text
  Note: 'Transaction fact. Grain: one HTTP attempt to fetch one page.'
}
