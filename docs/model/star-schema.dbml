// Phase 10 marketplace star schema (proposed, docs/PLAN_PHASE10_DIMENSIONAL_MODEL.md).
// Paste into https://dbdiagram.io/d to draw it.

Project marketplace_dw {
  database_type: 'PostgreSQL'
  Note: 'Kimball star for the marketplace price branch. Surrogate keys are deterministic xxhash64; -1 is the unknown member.'
}

TableGroup dimensions {
  dw.dim_date
  dw.dim_marketplace
  dw.dim_seller
  dw.dim_category
  dw.bridge_category_ancestry
  dw.dim_product_listing
  dw.dim_offer_status
}

TableGroup facts {
  dw.fact_offer_observation
  dw.fact_price_snapshot_daily
  dw.fact_price_change
  dw.fact_counter_daily
  dw.fact_crawl_attempt
}

Table dw.dim_date {
  date_key int [pk, note: 'yyyymmdd']
  full_date date [unique, not null]
  day_of_week smallint
  iso_week smallint
  month smallint
  quarter smallint
  year smallint
  is_weekend boolean
  is_double_day_sale boolean [note: '1/1, 2/2 ... 12/12']
  is_vn_holiday boolean
  Note: 'Conformed with the Kaggle behavior star.'
}

Table dw.dim_marketplace {
  marketplace_key smallint [pk]
  marketplace_code varchar [unique, not null, note: 'tiki']
  marketplace_id varchar
  marketplace_name varchar
  platform_type varchar [note: 'marketplace | retailer | classifieds | price_comparison']
  country char(2)
  currency char(3)
  first_crawled_at timestamptz
  Note: 'SCD1. A new marketplace is a new row.'
}

Table dw.dim_seller {
  seller_key bigint [pk]
  seller_id varchar [unique, not null]
  marketplace_key smallint [ref: > dw.dim_marketplace.marketplace_key]
  first_seen_at timestamptz
  last_seen_at timestamptz
  observed_listing_count int
  Note: 'SCD1.'
}

Table dw.dim_category {
  category_key int [pk]
  category_id varchar [unique, not null]
  marketplace_key smallint [ref: > dw.dim_marketplace.marketplace_key]
  category_name varchar [null]
  parent_key int [ref: > dw.dim_category.category_key]
  level smallint
  full_path varchar [note: '1/2/1789/1795']
  is_leaf boolean
  Note: 'Ragged hierarchy (4-8 levels): the one deliberate snowflake.'
}

Table dw.bridge_category_ancestry {
  ancestor_key int [ref: > dw.dim_category.category_key]
  descendant_key int [ref: > dw.dim_category.category_key]
  depth smallint
  indexes {
    (ancestor_key, descendant_key) [pk]
  }
  Note: 'Closure table: every product under node X in one join.'
}

Table dw.dim_product_listing {
  listing_key bigint [pk, note: 'xxhash64(offer_id, valid_from)']
  offer_id varchar [not null]
  marketplace_key smallint [ref: > dw.dim_marketplace.marketplace_key]
  platform_listing_id varchar
  product_title text [note: 'SCD2']
  brand varchar [null, note: 'SCD2; empty for 13.9% of products']
  category_key int [ref: > dw.dim_category.category_key, note: 'SCD2']
  seller_key bigint [ref: > dw.dim_seller.seller_key, note: 'SCD2']
  source_url text [note: 'SCD1']
  currency char(3)
  valid_from timestamptz [not null]
  valid_to timestamptz [note: 'exclusive; 9999-12-31 for the current row']
  is_current boolean
  version int
  indexes {
    (offer_id, valid_from) [unique]
  }
}

Table dw.dim_offer_status {
  offer_status_key smallint [pk]
  availability varchar
  active_status varchar
  has_discount boolean
  has_rating boolean
  Note: 'Junk dimension, about 30 rows.'
}

Table dw.fact_offer_observation {
  observation_id varchar [pk, note: 'degenerate dimension']
  date_key int [ref: > dw.dim_date.date_key]
  marketplace_key smallint [ref: > dw.dim_marketplace.marketplace_key]
  listing_key bigint [ref: > dw.dim_product_listing.listing_key, note: 'version valid at observed_at']
  seller_key bigint [ref: > dw.dim_seller.seller_key]
  category_key int [ref: > dw.dim_category.category_key]
  offer_status_key smallint [ref: > dw.dim_offer_status.offer_status_key]
  observed_at timestamptz
  current_price numeric(38,6)
  list_price numeric(38,6)
  discount_percent numeric(9,4)
  rating_value numeric(4,2)
  rating_count bigint
  review_count bigint
  sold_count bigint
  ranking_position int
  crawl_run_id varchar [note: 'lineage']
  raw_uri text [note: 'lineage to Bronze body.bin']
  Note: 'Transaction fact. Grain: one sighting of one listing at one instant.'
}

Table dw.fact_price_snapshot_daily {
  date_key int [ref: > dw.dim_date.date_key]
  listing_key bigint [ref: > dw.dim_product_listing.listing_key]
  currency char(3)
  marketplace_key smallint [ref: > dw.dim_marketplace.marketplace_key]
  seller_key bigint [ref: > dw.dim_seller.seller_key]
  category_key int [ref: > dw.dim_category.category_key]
  offer_status_key smallint [ref: > dw.dim_offer_status.offer_status_key, note: 'end of day']
  open_price numeric(38,6)
  close_price numeric(38,6)
  min_price numeric(38,6)
  max_price numeric(38,6)
  avg_price numeric(38,6)
  observation_count int
  distinct_price_count int
  in_stock_ratio numeric(5,4)
  indexes {
    (date_key, listing_key, currency) [pk]
  }
  Note: 'Periodic snapshot. Grain: one listing x day x currency with at least one sighting.'
}

Table dw.fact_price_change {
  price_change_id varchar [pk]
  date_key int [ref: > dw.dim_date.date_key]
  marketplace_key smallint [ref: > dw.dim_marketplace.marketplace_key]
  listing_key bigint [ref: > dw.dim_product_listing.listing_key]
  seller_key bigint [ref: > dw.dim_seller.seller_key]
  category_key int [ref: > dw.dim_category.category_key]
  changed_at timestamptz
  old_price numeric(38,6)
  new_price numeric(38,6)
  delta numeric(38,6)
  pct_change numeric(9,4)
  minutes_since_previous numeric(10,2)
  direction varchar [note: 'up | down']
  is_large_drop boolean
  reverted_within_next_obs boolean
  Note: 'Transaction fact (derived). Grain: one change of a listing price versus its previous sighting.'
}

Table dw.fact_counter_daily {
  date_key int [ref: > dw.dim_date.date_key]
  listing_key bigint [ref: > dw.dim_product_listing.listing_key]
  counter_name varchar
  marketplace_key smallint [ref: > dw.dim_marketplace.marketplace_key]
  first_value bigint
  last_value bigint
  valid_delta_sum bigint
  invalid_transition_count int
  velocity_proxy_per_hour double
  indexes {
    (date_key, listing_key, counter_name) [pk]
  }
  Note: 'Periodic snapshot. Public counters (sold_count, review_count); a proxy, not sales.'
}

Table dw.fact_crawl_attempt {
  attempt_id varchar [pk]
  date_key int [ref: > dw.dim_date.date_key]
  marketplace_key smallint [ref: > dw.dim_marketplace.marketplace_key]
  category_key int [ref: > dw.dim_category.category_key, note: 'category page crawled']
  started_at timestamptz
  completed_at timestamptz
  status varchar
  http_status int
  error_kind varchar
  latency_ms bigint
  raw_bytes bigint
  parsed_count int
  rejected_count int
  Note: 'Transaction fact. Grain: one attempt to crawl one page.'
}
