# ============================================================
# Big Data Lambda Architecture - Environment Configuration
# ============================================================

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=kafka:19092
KAFKA_TOPIC_EVENTS=ecommerce_events
KAFKA_TOPIC_ORDERS=ecommerce_orders
KAFKA_TOPIC_PRICES=ecommerce_prices

# --- Spark ---
SPARK_MASTER_URL=spark://spark:7077
SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.13:4.1.1

# --- MinIO (S3-compatible Data Lake) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_RAW=ecommerce-raw
MINIO_BUCKET_PROCESSED=ecommerce-processed

# --- Postgres Data Warehouse ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=data_warehouse

# --- Redis (Real-time Serving) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Elasticsearch ---
ES_HOST=http://localhost:9200
ES_INDEX_EVENTS=ecommerce-events
ES_INDEX_ANOMALIES=ecommerce-anomalies

# --- Data Simulator ---
SIMULATOR_PRODUCTS_COUNT=100
SIMULATOR_USERS_COUNT=1000
SIMULATOR_EVENTS_PER_SECOND=50
