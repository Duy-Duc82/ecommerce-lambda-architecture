{
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "@timestamp":          { "type": "date" },
      "anomaly_id":          { "type": "keyword" },
      "anomaly_type":        { "type": "keyword" },
      "severity":            { "type": "keyword" },
      "z_score":             { "type": "float" },
      "iqr_score":           { "type": "float" },
      "anomaly_score":       { "type": "float" },
      "baseline_value":      { "type": "float" },
      "observed_value":      { "type": "float" },
      "deviation_pct":       { "type": "float" },
      "metric_name":         { "type": "keyword" },
      "category":            { "type": "keyword" },
      "product_id":          { "type": "keyword" },
      "product_name":        { "type": "text", "fields": { "keyword": { "type": "keyword" } } },
      "region":              { "type": "keyword" },
      "window_start":        { "type": "date" },
      "window_end":          { "type": "date" },
      "description":         { "type": "text" },
      "is_resolved":         { "type": "boolean" },
      "resolved_at":         { "type": "date" },
      "alert_rule_id":       { "type": "keyword" },
      "detection_method":    { "type": "keyword" },
      "ingest_timestamp":    { "type": "date" }
    }
  },
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "refresh_interval": "5s"
  }
}
