{
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "@timestamp":          { "type": "date" },
      "product_id":          { "type": "keyword" },
      "product_name":        { "type": "text", "fields": { "keyword": { "type": "keyword" } } },
      "category":            { "type": "keyword" },
      "brand":               { "type": "keyword" },
      "old_price":           { "type": "float" },
      "new_price":           { "type": "float" },
      "price_change_pct":    { "type": "float" },
      "price_change_abs":    { "type": "float" },
      "price_direction":     { "type": "keyword" },
      "change_reason":       { "type": "keyword" },
      "demand_score":        { "type": "float" },
      "inventory_level":     { "type": "integer" },
      "competitor_price":    { "type": "float" },
      "sma_7d":              { "type": "float" },
      "ema_14d":             { "type": "float" },
      "forecast_7d":         { "type": "float" },
      "forecast_30d":        { "type": "float" },
      "volatility_score":    { "type": "float" },
      "elasticity_index":    { "type": "float" },
      "season_factor":       { "type": "float" },
      "ingest_timestamp":    { "type": "date" }
    }
  },
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "refresh_interval": "10s"
  }
}
