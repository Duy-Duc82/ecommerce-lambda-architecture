      "tax_amount":          { "type": "float" },
      "net_revenue":         { "type": "float" },
      "currency":            { "type": "keyword" },
      "items_count":         { "type": "integer" },
      "region":              { "type": "keyword" },
      "city":                { "type": "keyword" },
      "geo_location":        { "type": "geo_point" },
      "device_type":         { "type": "keyword" },
      "platform":            { "type": "keyword" },
      "coupon_code":         { "type": "keyword" },
