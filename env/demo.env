# Demo stack (Phase 9 plan section 11). Offline: the crawler reads the stub, never Tiki.
# Load with: .\scripts\mp.ps1 -EnvFile env/demo.env <command>
# Values here override .env for that one call; mp.ps1 restores the caller's
# environment afterwards. Every published port differs from the defaults
# (the live stack) and from the other isolated stack, and each host-side
# client address equals its *_HOST_PORT, as in .env.example.

COMPOSE_PROJECT_NAME=mp-demo
MP_CONTAINER_PREFIX=demo-

# The offline stub, never the live marketplace.
TIKI_LISTING_URL=http://stub-source:8000/api/personalish/v1/blocks/listings

# Host ports published by docker-compose.yml
KAFKA_HOST_PORT=9292
POSTGRES_HOST_PORT=5435
MINIO_API_HOST_PORT=9020
MINIO_CONSOLE_HOST_PORT=9021
REDIS_HOST_PORT=6381
ES_HOST_PORT=9202
KIBANA_HOST_PORT=5603
SUPERSET_HOST_PORT=8087
SPARK_UI_HOST_PORT=8092
SPARK_RPC_HOST_PORT=7079
SPARK_WORKER_UI_HOST_PORT=8093

# Host-side clients (drills, ops on the host): each equals its port above
KAFKA_BOOTSTRAP_SERVERS=localhost:9292
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
MINIO_ENDPOINT=localhost:9020
REDIS_HOST=localhost
REDIS_PORT=6381
ES_HOST=http://localhost:9202
