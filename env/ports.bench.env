# Host ports of the bench stack (published by compose/docker-compose.yml and
# compose/docker-compose.observability.yml). Every value differs from the
# defaults (the live stack) and from every other stack's ports file;
# tests/unit/ops/test_compose_isolation.py checks that.
KAFKA_HOST_PORT=9192
POSTGRES_HOST_PORT=5434
MINIO_API_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011
REDIS_HOST_PORT=6380
ES_HOST_PORT=9201
KIBANA_HOST_PORT=5602
SUPERSET_HOST_PORT=8089
SPARK_UI_HOST_PORT=8090
SPARK_RPC_HOST_PORT=7078
SPARK_WORKER_UI_HOST_PORT=8091
AIRFLOW_HOST_PORT=8184
LOKI_HOST_PORT=3105
GRAFANA_HOST_PORT=3005

# Host-side clients (drills, ops on the host): each equals its port above.
KAFKA_BOOTSTRAP_SERVERS=localhost:9192
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
MINIO_ENDPOINT=localhost:9010
REDIS_HOST=localhost
REDIS_PORT=6380
ES_HOST=http://localhost:9201
