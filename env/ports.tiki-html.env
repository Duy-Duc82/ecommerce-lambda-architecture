# Host ports of the tiki-html stack (published by compose/docker-compose.yml and
# compose/docker-compose.observability.yml). Every value differs from the
# defaults (the live stack) and from every other stack's ports file;
# tests/unit/ops/test_compose_isolation.py checks that.
KAFKA_HOST_PORT=9492
POSTGRES_HOST_PORT=5437
MINIO_API_HOST_PORT=9040
MINIO_CONSOLE_HOST_PORT=9041
REDIS_HOST_PORT=6383
ES_HOST_PORT=9204
KIBANA_HOST_PORT=5605
SUPERSET_HOST_PORT=8085
SPARK_UI_HOST_PORT=8096
SPARK_RPC_HOST_PORT=7081
SPARK_WORKER_UI_HOST_PORT=8097
AIRFLOW_HOST_PORT=8484
LOKI_HOST_PORT=3103
GRAFANA_HOST_PORT=3003
PROMETHEUS_HOST_PORT=9093
ALLOY_HOST_PORT=12353

# Host-side clients (drills, ops on the host): each equals its port above.
KAFKA_BOOTSTRAP_SERVERS=localhost:9492
POSTGRES_HOST=localhost
POSTGRES_PORT=5437
MINIO_ENDPOINT=localhost:9040
REDIS_HOST=localhost
REDIS_PORT=6383
ES_HOST=http://localhost:9204
