# Live collection stack (Phase 9 plan section 4, decision D1, accepted 2026-10-04).
# Nothing but live collection ever runs in this project: no smoke, drill,
# benchmark or demo. Use: .\scripts\mp.ps1 -EnvFile env/live.env <command>
COMPOSE_PROJECT_NAME=mp-live

# The frozen monitored universe: five categories x 3 listing pages, ACTIVE tier
# (60-minute cadence). Each returned total=2000 when probed on 2026-08-16.
TIKI_CATEGORIES=1846,8322,1882,1520,931
LIVE_SEED_PAGES=3
LIVE_SEED_TIER=ACTIVE

# The live source. Never point this project at the stub.
TIKI_LISTING_URL=https://tiki.vn/api/personalish/v1/blocks/listings
