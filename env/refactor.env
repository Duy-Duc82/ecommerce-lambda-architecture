# Refactor end-to-end stack (docs/PLAN_REFACTOR_ARCHITECTURE.md, AC12).
# Live Tiki and live Lazada, public pages only, robots.txt obeyed.
# Load with: .\scripts\mp.ps1 -EnvFile env/refactor.env <command>
# Settings layer as env/base.env + env/ports.refactor.env + this file.
# Isolated from every other stack: own project, container prefix, volumes, ports.

COMPOSE_PROJECT_NAME=mp-refactor
MP_CONTAINER_PREFIX=rf-

# Empty: the sources' own sites. Never the stub in this stack.
TIKI_BASE_URL=
LAZADA_BASE_URL=

# Tiki: one request every 2 s or slower, category pages. Lazada's 5 s per page,
# one tab, is enforced by its source spec; this value can only slow it down.
CRAWL_REQUEST_DELAY_SECONDS=2.0
CRAWL_ACTIVE_CADENCE_MINUTES=60
CRAWL_SOURCES=tiki
LAZADA_WORKER_BATCH_SIZE=1

# Airflow tasks run these images on this stack's network.
AIRFLOW_SPARK_IMAGE=ecommerce/spark-marketplace:4.0.1-r3
AIRFLOW_PYTHON_IMAGE=ecommerce/marketplace-python:2
