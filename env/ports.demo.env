# Host ports of the demo stack (published by compose/docker-compose.yml and
# compose/docker-compose.observability.yml). Every value differs from the
# defaults (the live stack) and from every other stack's ports file;
# tests/unit/ops/test_compose_isolation.py checks that.
KAFKA_HOST_PORT=9292
POSTGRES_HOST_PORT=5435
MINIO_API_HOST_PORT=9020
MINIO_CONSOLE_HOST_PORT=9021
REDIS_HOST_PORT=6381
ES_HOST_PORT=9202
KIBANA_HOST_PORT=5603
SUPERSET_HOST_PORT=8087
SPARK_UI_HOST_PORT=8092
SPARK_RPC_HOST_PORT=7079
SPARK_WORKER_UI_HOST_PORT=8093
AIRFLOW_HOST_PORT=8284
LOKI_HOST_PORT=3106
GRAFANA_HOST_PORT=3006
PROMETHEUS_HOST_PORT=9096
ALLOY_HOST_PORT=12356

# Host-side clients (drills, ops on the host): each equals its port above.
KAFKA_BOOTSTRAP_SERVERS=localhost:9292
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
MINIO_ENDPOINT=localhost:9020
REDIS_HOST=localhost
REDIS_PORT=6381
ES_HOST=http://localhost:9202
