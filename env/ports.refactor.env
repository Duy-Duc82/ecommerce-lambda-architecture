# Host ports of the refactor stack (published by compose/docker-compose.yml and
# compose/docker-compose.observability.yml). Every value differs from the
# defaults (the live stack) and from every other stack's ports file;
# tests/unit/ops/test_compose_isolation.py checks that.
KAFKA_HOST_PORT=9392
POSTGRES_HOST_PORT=5436
MINIO_API_HOST_PORT=9030
MINIO_CONSOLE_HOST_PORT=9031
REDIS_HOST_PORT=6382
ES_HOST_PORT=9203
KIBANA_HOST_PORT=5604
SUPERSET_HOST_PORT=8086
SPARK_UI_HOST_PORT=8094
SPARK_RPC_HOST_PORT=7080
SPARK_WORKER_UI_HOST_PORT=8095
AIRFLOW_HOST_PORT=8384
LOKI_HOST_PORT=3104
GRAFANA_HOST_PORT=3004

# Host-side clients (drills, ops on the host): each equals its port above.
KAFKA_BOOTSTRAP_SERVERS=localhost:9392
POSTGRES_HOST=localhost
POSTGRES_PORT=5436
MINIO_ENDPOINT=localhost:9030
REDIS_HOST=localhost
REDIS_PORT=6382
ES_HOST=http://localhost:9203
