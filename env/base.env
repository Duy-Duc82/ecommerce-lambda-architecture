# Settings shared by every stack. mp.ps1 loads this file first, then
# env/ports.<stack>.env, then env/<stack>.env; each later file overrides.
#
# The three secrets are DEVELOPMENT values for a stack that publishes its ports
# on localhost only. They are not secrets worth keeping: replace them (and
# never reuse them) before exposing a stack beyond this machine.
KIBANA_ENCRYPTION_KEY=7bca77b7eaef801f05c682111ebc77a21f7312934917771eb5c3e5f8727d02cd
AIRFLOW_FERNET_KEY=J0kaGr81jGlfZFZRltkp3ZzylGGtN9QH5QKGm-nU88g=
AIRFLOW_JWT_SECRET=cc6f3fd46f523021c74c819bbeb0a8879d457dc0a7a23e2d6cb5cd37be18a64c

# Politeness between two requests to one host; a source may enforce more
# (Lazada: 5 s per page, in its source spec).
CRAWL_REQUEST_DELAY_SECONDS=2.0
# Explicit, so no job runs on Spark's 1g default.
SPARK_DRIVER_MEMORY=3g
# Images the DAGs start for their tasks.
AIRFLOW_SPARK_IMAGE=ecommerce/spark-marketplace:4.0.1-r3
AIRFLOW_PYTHON_IMAGE=ecommerce/marketplace-python:2
