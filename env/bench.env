# Benchmark stack (Phase 9 plan sections 5 and 8). Replayed fixtures only; never live data.
# Load with: .\scripts\mp.ps1 -EnvFile env/bench.env <command>
# Values here override .env for that one call; mp.ps1 restores the caller's
# environment afterwards. Every published port differs from the defaults
# (the live stack) and from the other isolated stack, and each host-side
# client address equals its *_HOST_PORT, as in .env.example.

COMPOSE_PROJECT_NAME=mp-bench
MP_CONTAINER_PREFIX=bench-

# The offline stub, never the live marketplace.
TIKI_LISTING_URL=http://stub-source:8000/api/personalish/v1/blocks/listings

# Host ports published by docker-compose.yml
KAFKA_HOST_PORT=9192
POSTGRES_HOST_PORT=5434
MINIO_API_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011
REDIS_HOST_PORT=6380
ES_HOST_PORT=9201
KIBANA_HOST_PORT=5602
SUPERSET_HOST_PORT=8089
SPARK_UI_HOST_PORT=8090
SPARK_RPC_HOST_PORT=7078
SPARK_WORKER_UI_HOST_PORT=8091

# Host-side clients (drills, ops on the host): each equals its port above
KAFKA_BOOTSTRAP_SERVERS=localhost:9192
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
MINIO_ENDPOINT=localhost:9010
REDIS_HOST=localhost
REDIS_PORT=6380
ES_HOST=http://localhost:9201
