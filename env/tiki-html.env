# Long-run check of the Tiki category-page adapter (crawler/sites/tiki_html.py)
# against the full stack. Live Tiki pages, public HTML only, no listing API.
# Load with: .\scripts\mp.ps1 -EnvFile env/tiki-html.env <command>
# Isolated from mp-live and mp-bench: own project, container prefix, volumes.

COMPOSE_PROJECT_NAME=mp-tikihtml
MP_CONTAINER_PREFIX=th-

# The crawl worker uses the category-page adapter. Targets are "<slug>/c<id>"
# from env/tiki_html_categories.json, seeded at page 1 only.
CRAWL_SITE=tiki-html
# 60 categories every 30 minutes: 120 page loads an hour, one at a time,
# 2 s apart. Category pages took 1 request/s without a challenge (2026-10-12).
CRAWL_ACTIVE_CADENCE_MINUTES=30
CRAWL_REQUEST_DELAY_SECONDS=2.0

# Host ports published by docker-compose.yml
KAFKA_HOST_PORT=9192
POSTGRES_HOST_PORT=5434
MINIO_API_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011
REDIS_HOST_PORT=6380
ES_HOST_PORT=9201
KIBANA_HOST_PORT=5602
SUPERSET_HOST_PORT=8089
SPARK_UI_HOST_PORT=8090
SPARK_RPC_HOST_PORT=7078
SPARK_WORKER_UI_HOST_PORT=8091

# Host-side clients (drills, ops on the host): each equals its port above
KAFKA_BOOTSTRAP_SERVERS=localhost:9192
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
MINIO_ENDPOINT=localhost:9010
REDIS_HOST=localhost
REDIS_PORT=6380
ES_HOST=http://localhost:9201
